12. 11 - Container With Most Water
class Solution {
    public int maxArea(int[] a) {
        int l = 0;
        int r = a.length - 1;
        int m = 0;
        while (l < r) {
            int c = Math.min(a[l], a[r]) * (r - l);
            m = Math.max(c, m);
            if (a[l] < a[r]) {
                l++;
            } else {
                r--;
            }
        }
        return m;
    }
}
13. 75 - Sort Colors
class Solution {
    public void sortColors(int[] a) {
        for (int i = 0; i < a.length; i++) {
            for (int j = 0; j < a.length - 1 - i; j++) {
                if (a[j] > a[j + 1]) {
                    int t = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = t;
                }
            }
        }
    }
}
