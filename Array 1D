5. 66 - Plus One
class Solution {
    public int[] plusOne(int[] digit) {
        for (int i = digit.length - 1; i >= 0; i--) {
            if (digit[i] < 9) {
                digit[i]++;
                return digit;
            }
            digit[i] = 0;
        }
        int b[] = new int[digit.length + 1];
        b[0] = 1;
        return b;
    }
}
6. 643 - Maximum Average Subarray I
class Solution {
    public double findMaxAverage(int[] a, int k) {
        int s = 0;
        // First window
        for (int i = 0; i < k; i++) {
            s += a[i];
        }
        int max = s;
        // Sliding window
        for (int i = k; i < a.length; i++) {
            s = s - a[i - k] + a[i];
            max = Math.max(s, max);
        }
        return (double) max / k;
    }
}
7. 268 - Missing Number
class Solution {
    public int missingNumber(int[] nums) {
        int n = nums.length;
        int a = n * (n + 1) / 2;
        int c = 0;
        for (int b : nums) {
            c += b;
        }
        return a - c;
    }
}
8. 1365 - How Many Numbers Are Smaller Than the Current Number
class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int[] a = new int[nums.length];
        for (int i = 0; i < a.length; i++) {
            int c = 0;
            for (int j = 0; j < a.length; j++) {
                if (nums[j] < nums[i]) {
                    c = c + 1;
                }
            }
            a[i] = c;
        }
        return a;
    }
}
9. 2574 - Left and Right Sum Differences
class Solution {
    public int[] leftRightDifference(int[] nums) {
        int a[] = new int[nums.length];
        for (int i = 0; i < nums.length; i++) {
            int l = 0;
            int r = 0;
            for (int j = 0; j < i; j++) {
                l += nums[j];
            }
            for (int j = i + 1; j < nums.length; j++) {
                r += nums[j];
            }
            int ab = Math.abs(l - r);
            a[i] = ab;
        }
        return a;
    }
}
10. 1475 - Final Prices With a Special Discount in a Shop
class Solution {
    public int[] finalPrices(int[] prices) {
        for (int i = 0; i < prices.length; i++) {
            for (int j = i + 1; j < prices.length; j++) {
                if (prices[j] <= prices[i]) {
                    prices[i] = prices[i] - prices[j];
                    break;
                }
            }
        }
        return prices;
    }
}
